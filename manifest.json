{
  "manifest_version": 3,
  "name": "Cleo - Custom New Tab",
  "short_name": "Cleo",
  "description": "A lightning-fast, highly customizable, and private new tab page.",
  "version": "1.0.1",
  "offline_enabled": true,
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self';"
  },
  "permissions": [
    "storage",
    "topSites",
    "favicon",
    "alarms",
    "notifications",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cleo-new-tab@joshitgupta-source.com",
      "strict_min_version": "109.0"
    }
  }
}